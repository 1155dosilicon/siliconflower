{
  "name": "siliconflower",
  "version": "0.9.0",
  "description": "AI agent for Windows and Linux, as a desktop app or web interface, with MCP, reasoning control, skills, and OpenAI-compatible backends.",
  "cpu": [
    "x64"
  ],
  "os": [
    "win32",
    "linux"
  ],
  "type": "module",
  "license": "MIT",
  "author": "siliconflower contributors",
  "homepage": "https://github.com/1155dosilicon/siliconflower#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/1155dosilicon/siliconflower.git"
  },
  "bugs": {
    "url": "https://github.com/1155dosilicon/siliconflower/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "mcp",
    "openai",
    "siliconflow",
    "openrouter",
    "reasoning",
    "tools",
    "bun"
  ],
  "bin": {
    "siliconflower": "bin/siliconflower.js"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run src/index.tsx",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "desktop": "bun run --cwd desktop start",
    "typecheck:desktop": "bun run --cwd desktop typecheck",
    "desktop:dist": "bun run build && bun run --cwd desktop dist",
    "desktop:install": "bash scripts/install-appimage.sh",
    "install:bin": "node scripts/install-bin.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^12.1.0",
    "openai": "^4.73.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "bun-types": "^1.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
